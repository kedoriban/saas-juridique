# .env.gpu.example — Template pour l'instance GPU Vast.ai
# Copier ce fichier en .env.local à la racine du repo sur l'instance :
#   cp .env.gpu.example .env.local
# Puis remplir les deux valeurs Supabase.

# --- Supabase (obligatoire) ---
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# --- LLM : vLLM sur GPU local (ne pas modifier) ---
LLM_PROVIDER=vllm
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
LLM_TIMEOUT_SECONDS=300
LLM_MAX_INPUT_CHARS=16000
LLM_MAX_OUTPUT_TOKENS=4000
LLM_STORE_RAW_OUTPUT=false
