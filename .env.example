# Supabase – à récupérer depuis le dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LLM local – Ollama (worker uniquement, jamais exposé côté client)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct-q4_K_M

# LLM sur GPU loué – vLLM (cf. worker/DEPLOY_GPU.md). Décommenter sur la machine louée.
# LLM_PROVIDER=vllm
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
# LLM_MAX_OUTPUT_TOKENS=1500

# Scraping CCE/RVV
CCE_BASE_URL=https://www.cce-rvv.be

# Optionnel – clé API LLM distant si remplacement Ollama en production
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
